{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NewPoke map",
  "description": "Mapa de NewPoke: rejilla de terrenos, respawns y cordilleras.",
  "type": "object",
  "required": ["tiles", "respawns"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string" },
    "name": { "type": "string" },
    "tileSize": { "type": "number", "exclusiveMinimum": 0 },
    "waterHeight": { "type": "number" },
    "spawn": { "$ref": "#/$defs/point" },
    "respawns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["team", "x", "z"],
        "properties": {
          "team": { "enum": ["blue", "red"] },
          "x": { "type": "number" },
          "z": { "type": "number" },
          "radius": { "type": "number", "exclusiveMinimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "mountains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["width", "points"],
        "properties": {
          "width": { "type": "number", "exclusiveMinimum": 0 },
          "points": {
            "type": "array",
            "minItems": 2,
            "items": { "$ref": "#/$defs/point" }
          }
        },
        "additionalProperties": false
      }
    },
    "tiles": {
      "type": "array",
      "minItems": 1,
      "description": "Filas de norte a sur; cada fila va de oeste a este. La rejilla debe ser cuadrada.",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "enum": [
            "jungle",
            "lane",
            "road",
            "sand",
            "waterLow",
            "waterHigh",
            "base",
            "tallGrass",
            "fire",
            "electric",
            "ice",
            "poison",
            "ghost",
            "fairy",
            "desert"
          ]
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": ["x", "z"],
      "properties": {
        "x": { "type": "number" },
        "z": { "type": "number" }
      },
      "additionalProperties": false
    }
  }
}
