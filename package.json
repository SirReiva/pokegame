{
  "name": "newpoke",
  "private": true,
  "version": "0.29.16",
  "homepage": "https://sirreiva.github.io/pokegame/",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite --host",
    "dev:model": "vite --host --open /demo/",
    "convert:model": "node tools/blender/convert_model.mjs",
    "models:atlas": "node tools/models/atlas-glb.mjs",
    "build": "tsc -b && vite build",
    "build:dev": "vite build --mode development",
    "desktop:dev": "wails3 dev",
    "desktop:build": "wails3 build",
    "desktop:build:windows": "wails3 build GOOS=windows",
    "desktop:build:linux": "wails3 build GOOS=linux",
    "desktop:package": "wails3 package",
    "sprites": "node scripts/import-sprites.mjs",
    "sprites:bleed": "node scripts/preprocess-sprites.mjs",
    "sprites:metadata": "node scripts/patch-sprite-metadata.mjs",
    "validate:anims": "node --import tsx scripts/validate-anim-timings.ts",
    "sfx": "node scripts/import-sfx.mjs",
    "maps:designs": "node scripts/generate-arena-designs.mjs",
    "maps:previews": "node scripts/generate-map-previews.mjs",
    "items:art": "node scripts/generate-item-art.mjs",
    "lint": "twlinter --fix --no-config --json && oxlint",
    "check:arch": "node scripts/check-architecture.mjs",
    "check": "tsc -b && node scripts/check-architecture.mjs",
    "test": "node scripts/run-tests.mjs",
    "bench": "node --import tsx scripts/bench-core.mjs",
    "bench:frame": "node scripts/bench-frame.mjs",
    "sim": "node --import tsx scripts/sim-headless.ts",
    "balance": "node --import tsx scripts/balance-report.ts",
    "balance:teams": "node --import tsx scripts/balance-teams.ts",
    "balance:teams:parallel": "node --import tsx scripts/balance-teams-parallel.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "playcanvas": "2.24.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "wouter": "3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "oxlint": "1.94.0",
    "piscina": "^5.3.2",
    "scriptc": "^0.4.14",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "twlinter": "0.8.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
