{
  "name": "newpoke",
  "private": true,
  "version": "0.16.1",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "build:dev": "vite build --mode development",
    "desktop:dev": "wails3 dev",
    "desktop:build": "wails3 build",
    "desktop:build:windows": "wails3 build GOOS=windows",
    "desktop:build:linux": "wails3 build GOOS=linux",
    "desktop:package": "wails3 package",
    "sprites": "node scripts/import-sprites.mjs",
    "sfx": "node scripts/import-sfx.mjs",
    "maps:previews": "node scripts/generate-map-previews.mjs",
    "items:art": "node scripts/generate-item-art.mjs",
    "lint": "twlinter --fix --no-config --json && oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "playcanvas": "2.23.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "wouter": "3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "oxlint": "1.91.0",
    "tailwindcss": "4.3.4",
    "twlinter": "0.8.0",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
